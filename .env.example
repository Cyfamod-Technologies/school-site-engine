LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Origin allowed to embed /schools/{slug}/preview in an iframe (the admin
# frontend, school-fe-nextjs). Server-only, used to set a scoped CSP
# frame-ancestors header -- NOT prefixed with NEXT_PUBLIC_ since it doesn't
# need to reach the browser, only the server that sets response headers.
ADMIN_APP_ORIGIN=http://localhost:3000

# Domains proxy.ts should NOT try to resolve as a school's custom domain --
# this app's own default deployment domain(s), plus localhost during dev.
# Comma-separated. Without this correctly set for each environment, every
# request to this app's own default address would attempt (and fail) a
# domain lookup instead of just serving normally.
PASSTHROUGH_HOSTS=localhost:3001
